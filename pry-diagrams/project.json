{
  "name": "pry-diagrams",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "pry-diagrams/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/pry-diagrams"],
      "options": {
        "command": "npm run build",
        "cwd": "pry-diagrams"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "pry-diagrams"
      }
    }
  }
}
