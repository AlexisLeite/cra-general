<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Complex"
  targetNamespace="https://example.com/bpmn/complex-procurement"
>
  <bpmn:process id="Process_Procurement" name="Complex Procurement Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Procurement">
      <bpmn:lane id="Lane_Requestor" name="Requestor">
        <bpmn:flowNodeRef>Start_RequestSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RequestValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BudgetCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BudgetEnough</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RequestRejected</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Manager" name="Manager">
        <bpmn:flowNodeRef>Task_RequestFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallActivity_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_HandleException</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderCancelled</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Procurement" name="Procurement">
        <bpmn:flowNodeRef>Task_CreatePO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RunVendorScoring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectQuotes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_VendorChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendPO</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReceiveVendorAck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AckReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestLegalReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IntermediateCatch_WaitContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Transaction_Closeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OrderCompleted</bpmn:flowNodeRef>
      </bpmn:lane>

      <bpmn:lane id="Lane_Warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Task_PrepareGoods</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QualityInspection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QualityPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReworkGoods</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_RequestSubmitted" name="Request Submitted"/>
    <bpmn:userTask id="Task_ValidateRequest" name="Validate Request"/>
    <bpmn:exclusiveGateway id="Gateway_RequestValid" name="Request Valid?"/>
    <bpmn:userTask id="Task_RequestFix" name="Fix Request"/>
    <bpmn:serviceTask id="Task_BudgetCheck" name="Budget Check"/>
    <bpmn:exclusiveGateway id="Gateway_BudgetEnough" name="Budget Enough?"/>
    <bpmn:userTask id="Task_RequestApproval" name="Manager Approval"/>
    <bpmn:inclusiveGateway id="Gateway_ApprovalDecision" name="Decision Routing"/>
    <bpmn:task id="Task_CreatePO" name="Create Purchase Order"/>
    <bpmn:businessRuleTask id="Task_RunVendorScoring" name="Run Vendor Scoring"/>
    <bpmn:manualTask id="Task_CollectQuotes" name="Collect Quotes"/>
    <bpmn:parallelGateway id="Gateway_VendorChoice" name="Vendor Merge"/>
    <bpmn:sendTask id="Task_SendPO" name="Send PO to Vendor"/>
    <bpmn:receiveTask id="Task_ReceiveVendorAck" name="Receive Vendor Ack"/>
    <bpmn:exclusiveGateway id="Gateway_AckReceived" name="Ack Received?"/>
    <bpmn:scriptTask id="Task_RequestLegalReview" name="Request Legal Review"/>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_WaitContract" name="Wait Contract Signed"/>
    <bpmn:task id="Task_PrepareGoods" name="Prepare Goods"/>
    <bpmn:task id="Task_QualityInspection" name="Quality Inspection"/>
    <bpmn:exclusiveGateway id="Gateway_QualityPass" name="Quality Pass?"/>
    <bpmn:task id="Task_ReworkGoods" name="Rework Goods"/>
    <bpmn:callActivity id="CallActivity_Escalate" name="Escalate to Steering Committee"/>
    <bpmn:subProcess id="SubProcess_HandleException" name="Handle Exception"/>
    <bpmn:transaction id="Transaction_Closeout" name="Closeout Transaction"/>
    <bpmn:endEvent id="End_RequestRejected" name="Rejected"/>
    <bpmn:endEvent id="End_OrderCancelled" name="Cancelled"/>
    <bpmn:endEvent id="End_OrderCompleted" name="Completed"/>

    <bpmn:sequenceFlow id="P1_F1" sourceRef="Start_RequestSubmitted" targetRef="Task_ValidateRequest"/>
    <bpmn:sequenceFlow id="P1_F2" sourceRef="Task_ValidateRequest" targetRef="Gateway_RequestValid"/>
    <bpmn:sequenceFlow id="P1_F3" sourceRef="Gateway_RequestValid" targetRef="Task_BudgetCheck"/>
    <bpmn:sequenceFlow id="P1_F4" sourceRef="Gateway_RequestValid" targetRef="Task_RequestFix"/>
    <bpmn:sequenceFlow id="P1_F5" sourceRef="Task_RequestFix" targetRef="Task_ValidateRequest"/>
    <bpmn:sequenceFlow id="P1_F6" sourceRef="Task_BudgetCheck" targetRef="Gateway_BudgetEnough"/>
    <bpmn:sequenceFlow id="P1_F7" sourceRef="Gateway_BudgetEnough" targetRef="Task_RequestApproval"/>
    <bpmn:sequenceFlow id="P1_F8" sourceRef="Gateway_BudgetEnough" targetRef="End_RequestRejected"/>
    <bpmn:sequenceFlow id="P1_F9" sourceRef="Task_RequestApproval" targetRef="Gateway_ApprovalDecision"/>
    <bpmn:sequenceFlow id="P1_F10" sourceRef="Gateway_ApprovalDecision" targetRef="Task_CreatePO"/>
    <bpmn:sequenceFlow id="P1_F11" sourceRef="Gateway_ApprovalDecision" targetRef="CallActivity_Escalate"/>
    <bpmn:sequenceFlow id="P1_F12" sourceRef="CallActivity_Escalate" targetRef="SubProcess_HandleException"/>
    <bpmn:sequenceFlow id="P1_F13" sourceRef="SubProcess_HandleException" targetRef="End_OrderCancelled"/>
    <bpmn:sequenceFlow id="P1_F14" sourceRef="Task_CreatePO" targetRef="Task_RunVendorScoring"/>
    <bpmn:sequenceFlow id="P1_F15" sourceRef="Task_CreatePO" targetRef="Task_CollectQuotes"/>
    <bpmn:sequenceFlow id="P1_F16" sourceRef="Task_RunVendorScoring" targetRef="Gateway_VendorChoice"/>
    <bpmn:sequenceFlow id="P1_F17" sourceRef="Task_CollectQuotes" targetRef="Gateway_VendorChoice"/>
    <bpmn:sequenceFlow id="P1_F18" sourceRef="Gateway_VendorChoice" targetRef="Task_SendPO"/>
    <bpmn:sequenceFlow id="P1_F19" sourceRef="Task_SendPO" targetRef="Task_ReceiveVendorAck"/>
    <bpmn:sequenceFlow id="P1_F20" sourceRef="Task_ReceiveVendorAck" targetRef="Gateway_AckReceived"/>
    <bpmn:sequenceFlow id="P1_F21" sourceRef="Gateway_AckReceived" targetRef="Task_RequestLegalReview"/>
    <bpmn:sequenceFlow id="P1_F22" sourceRef="Gateway_AckReceived" targetRef="End_OrderCancelled"/>
    <bpmn:sequenceFlow id="P1_F23" sourceRef="Task_RequestLegalReview" targetRef="IntermediateCatch_WaitContract"/>
    <bpmn:sequenceFlow id="P1_F24" sourceRef="IntermediateCatch_WaitContract" targetRef="Task_PrepareGoods"/>
    <bpmn:sequenceFlow id="P1_F25" sourceRef="Task_PrepareGoods" targetRef="Task_QualityInspection"/>
    <bpmn:sequenceFlow id="P1_F26" sourceRef="Task_QualityInspection" targetRef="Gateway_QualityPass"/>
    <bpmn:sequenceFlow id="P1_F27" sourceRef="Gateway_QualityPass" targetRef="Transaction_Closeout"/>
    <bpmn:sequenceFlow id="P1_F28" sourceRef="Gateway_QualityPass" targetRef="Task_ReworkGoods"/>
    <bpmn:sequenceFlow id="P1_F29" sourceRef="Task_ReworkGoods" targetRef="Task_QualityInspection"/>
    <bpmn:sequenceFlow id="P1_F30" sourceRef="Transaction_Closeout" targetRef="End_OrderCompleted"/>
  </bpmn:process>

  <bpmn:process id="Process_Finance" name="Finance Settlement Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Finance">
      <bpmn:lane id="Lane_AP" name="Accounts Payable">
        <bpmn:flowNodeRef>Start_InvoiceReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MatchInvoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_InvoiceMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AskClarification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FinanceRejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Treasury" name="Treasury">
        <bpmn:flowNodeRef>Task_SchedulePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PaymentMode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BankTransfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PostLedger</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PaymentDone</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_InvoiceReceived" name="Invoice Received"/>
    <bpmn:userTask id="Task_MatchInvoice" name="Match Invoice"/>
    <bpmn:exclusiveGateway id="Gateway_InvoiceMatch" name="Match OK?"/>
    <bpmn:task id="Task_AskClarification" name="Ask Clarification"/>
    <bpmn:serviceTask id="Task_SchedulePayment" name="Schedule Payment"/>
    <bpmn:parallelGateway id="Gateway_PaymentMode" name="Parallel Posting"/>
    <bpmn:sendTask id="Task_BankTransfer" name="Execute Bank Transfer"/>
    <bpmn:scriptTask id="Task_PostLedger" name="Post Ledger Entry"/>
    <bpmn:endEvent id="End_PaymentDone" name="Payment Done"/>
    <bpmn:endEvent id="End_FinanceRejected" name="Rejected in Finance"/>

    <bpmn:sequenceFlow id="P2_F1" sourceRef="Start_InvoiceReceived" targetRef="Task_MatchInvoice"/>
    <bpmn:sequenceFlow id="P2_F2" sourceRef="Task_MatchInvoice" targetRef="Gateway_InvoiceMatch"/>
    <bpmn:sequenceFlow id="P2_F3" sourceRef="Gateway_InvoiceMatch" targetRef="Task_SchedulePayment"/>
    <bpmn:sequenceFlow id="P2_F4" sourceRef="Gateway_InvoiceMatch" targetRef="Task_AskClarification"/>
    <bpmn:sequenceFlow id="P2_F5" sourceRef="Task_AskClarification" targetRef="End_FinanceRejected"/>
    <bpmn:sequenceFlow id="P2_F6" sourceRef="Task_SchedulePayment" targetRef="Gateway_PaymentMode"/>
    <bpmn:sequenceFlow id="P2_F7" sourceRef="Gateway_PaymentMode" targetRef="Task_BankTransfer"/>
    <bpmn:sequenceFlow id="P2_F8" sourceRef="Gateway_PaymentMode" targetRef="Task_PostLedger"/>
    <bpmn:sequenceFlow id="P2_F9" sourceRef="Task_BankTransfer" targetRef="End_PaymentDone"/>
    <bpmn:sequenceFlow id="P2_F10" sourceRef="Task_PostLedger" targetRef="End_PaymentDone"/>
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_Complex">
    <bpmn:participant
      id="Participant_Procurement"
      name="Procurement Org"
      processRef="Process_Procurement"
    />
    <bpmn:participant
      id="Participant_Finance"
      name="Finance Org"
      processRef="Process_Finance"
    />
    <bpmn:messageFlow
      id="MessageFlow_PaymentTrigger"
      sourceRef="End_OrderCompleted"
      targetRef="Start_InvoiceReceived"
      name="Trigger Invoice Settlement"
    />
  </bpmn:collaboration>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Complex">
    <bpmndi:BPMNPlane id="BPMNPlane_Complex" bpmnElement="Collaboration_Complex">
      <bpmndi:BPMNShape id="Participant_Procurement_di" bpmnElement="Participant_Procurement">
        <dc:Bounds x="100" y="80" width="5000" height="1040"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Requestor_di" bpmnElement="Lane_Requestor">
        <dc:Bounds x="100" y="80" width="5000" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager">
        <dc:Bounds x="100" y="340" width="5000" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Procurement_di" bpmnElement="Lane_Procurement">
        <dc:Bounds x="100" y="600" width="5000" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Warehouse_di" bpmnElement="Lane_Warehouse">
        <dc:Bounds x="100" y="860" width="5000" height="260"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Participant_Finance_di" bpmnElement="Participant_Finance">
        <dc:Bounds x="100" y="1160" width="1900" height="520"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AP_di" bpmnElement="Lane_AP">
        <dc:Bounds x="100" y="1160" width="1900" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Treasury_di" bpmnElement="Lane_Treasury">
        <dc:Bounds x="100" y="1420" width="1900" height="260"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_RequestSubmitted_di" bpmnElement="Start_RequestSubmitted">
        <dc:Bounds x="180" y="170" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateRequest_di" bpmnElement="Task_ValidateRequest">
        <dc:Bounds x="330" y="160" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RequestValid_di" bpmnElement="Gateway_RequestValid">
        <dc:Bounds x="620" y="170" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestFix_di" bpmnElement="Task_RequestFix">
        <dc:Bounds x="620" y="430" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BudgetCheck_di" bpmnElement="Task_BudgetCheck">
        <dc:Bounds x="820" y="160" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_BudgetEnough_di" bpmnElement="Gateway_BudgetEnough">
        <dc:Bounds x="1110" y="170" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestApproval_di" bpmnElement="Task_RequestApproval">
        <dc:Bounds x="1310" y="420" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ApprovalDecision_di" bpmnElement="Gateway_ApprovalDecision">
        <dc:Bounds x="1600" y="430" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreatePO_di" bpmnElement="Task_CreatePO">
        <dc:Bounds x="1820" y="680" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RunVendorScoring_di" bpmnElement="Task_RunVendorScoring">
        <dc:Bounds x="2050" y="650" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CollectQuotes_di" bpmnElement="Task_CollectQuotes">
        <dc:Bounds x="2050" y="790" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_VendorChoice_di" bpmnElement="Gateway_VendorChoice">
        <dc:Bounds x="2320" y="710" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendPO_di" bpmnElement="Task_SendPO">
        <dc:Bounds x="2510" y="700" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReceiveVendorAck_di" bpmnElement="Task_ReceiveVendorAck">
        <dc:Bounds x="2740" y="700" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AckReceived_di" bpmnElement="Gateway_AckReceived">
        <dc:Bounds x="2990" y="710" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestLegalReview_di" bpmnElement="Task_RequestLegalReview">
        <dc:Bounds x="3200" y="700" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatch_WaitContract_di" bpmnElement="IntermediateCatch_WaitContract">
        <dc:Bounds x="3430" y="710" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareGoods_di" bpmnElement="Task_PrepareGoods">
        <dc:Bounds x="3620" y="940" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_QualityInspection_di" bpmnElement="Task_QualityInspection">
        <dc:Bounds x="3870" y="940" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_QualityPass_di" bpmnElement="Gateway_QualityPass">
        <dc:Bounds x="4120" y="950" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReworkGoods_di" bpmnElement="Task_ReworkGoods">
        <dc:Bounds x="4380" y="940" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallActivity_Escalate_di" bpmnElement="CallActivity_Escalate">
        <dc:Bounds x="1820" y="430" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_HandleException_di" bpmnElement="SubProcess_HandleException">
        <dc:Bounds x="2060" y="430" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Transaction_Closeout_di" bpmnElement="Transaction_Closeout">
        <dc:Bounds x="4380" y="700" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RequestRejected_di" bpmnElement="End_RequestRejected">
        <dc:Bounds x="1310" y="170" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OrderCancelled_di" bpmnElement="End_OrderCancelled">
        <dc:Bounds x="2320" y="430" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OrderCompleted_di" bpmnElement="End_OrderCompleted">
        <dc:Bounds x="4620" y="700" width="80" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Start_InvoiceReceived_di" bpmnElement="Start_InvoiceReceived">
        <dc:Bounds x="220" y="1260" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MatchInvoice_di" bpmnElement="Task_MatchInvoice">
        <dc:Bounds x="380" y="1250" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_InvoiceMatch_di" bpmnElement="Gateway_InvoiceMatch">
        <dc:Bounds x="670" y="1260" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AskClarification_di" bpmnElement="Task_AskClarification">
        <dc:Bounds x="880" y="1250" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SchedulePayment_di" bpmnElement="Task_SchedulePayment">
        <dc:Bounds x="880" y="1510" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentMode_di" bpmnElement="Gateway_PaymentMode">
        <dc:Bounds x="1160" y="1520" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BankTransfer_di" bpmnElement="Task_BankTransfer">
        <dc:Bounds x="1360" y="1510" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PostLedger_di" bpmnElement="Task_PostLedger">
        <dc:Bounds x="1360" y="1610" width="220" height="100"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_PaymentDone_di" bpmnElement="End_PaymentDone">
        <dc:Bounds x="1660" y="1520" width="80" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_FinanceRejected_di" bpmnElement="End_FinanceRejected">
        <dc:Bounds x="1160" y="1250" width="80" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="P1_F1_di" bpmnElement="P1_F1"><di:waypoint x="260" y="210"/><di:waypoint x="330" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F2_di" bpmnElement="P1_F2"><di:waypoint x="550" y="210"/><di:waypoint x="620" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F3_di" bpmnElement="P1_F3"><di:waypoint x="700" y="210"/><di:waypoint x="820" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F4_di" bpmnElement="P1_F4"><di:waypoint x="660" y="250"/><di:waypoint x="660" y="480"/><di:waypoint x="620" y="480"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F5_di" bpmnElement="P1_F5"><di:waypoint x="730" y="430"/><di:waypoint x="730" y="260"/><di:waypoint x="330" y="260"/><di:waypoint x="330" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F6_di" bpmnElement="P1_F6"><di:waypoint x="1040" y="210"/><di:waypoint x="1110" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F7_di" bpmnElement="P1_F7"><di:waypoint x="1150" y="250"/><di:waypoint x="1150" y="470"/><di:waypoint x="1310" y="470"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F8_di" bpmnElement="P1_F8"><di:waypoint x="1190" y="210"/><di:waypoint x="1310" y="210"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F9_di" bpmnElement="P1_F9"><di:waypoint x="1530" y="470"/><di:waypoint x="1600" y="470"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P1_F10_di" bpmnElement="P1_F10"><di:waypoint x="1640" y="510"/><di:waypoint x="1640" y="730"/><di:waypoint x="1820" y="730"/></bpmndi:BPMNEdge>
